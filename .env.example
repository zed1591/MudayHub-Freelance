# ==============================================================================
# MudayHub Environment Configuration
# ==============================================================================

# Application & Runtime
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Layer 1: Distributed Rate Limiting (Upstash Redis)
# Optional in single-node/demo; recommended in multi-instance/serverless production.
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# Layer 2 & 5: Escrow Payment Gateways (Chapa & Telebirr)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=chapa
# Generate a unique 64-char hex secret: openssl rand -hex 32
ESCROW_WEBHOOK_SECRET=replace-with-a-random-64-character-hex-secret

# Chapa API credentials
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=replace-with-chapa-webhook-secret
CHAPA_ENABLE_PAYOUTS=true
CHAPA_ENABLE_REFUNDS=true

# Telebirr B2B credentials
TELEBIRR_MERCHANT_ID=
TELEBIRR_API_KEY=

# ------------------------------------------------------------------------------
# Layer 4 & 6: Supabase & Private Storage
# Required when DEMO_MODE=false
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Supabase Storage bucket name for deliverables & evidence
SUPABASE_STORAGE_BUCKET=contract-files

# ------------------------------------------------------------------------------
# Layer 7: Telegram Bot Real-time Milestone Alerts
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=MudayHubBot
TELEGRAM_DEFAULT_CHAT_ID=

# ------------------------------------------------------------------------------
# Transactional Email (Resend or SMTP)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=MudayHub Escrow <escrow@mudayhub.et>

# SMTP Fallback
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
